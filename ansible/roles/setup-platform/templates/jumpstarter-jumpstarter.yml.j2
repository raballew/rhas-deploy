apiVersion: operator.jumpstarter.dev/v1alpha1
kind: Jumpstarter
metadata:
  name: auto-jumpstarter
  labels:
    app.kubernetes.io/name: jumpstarter-operator
  namespace: "{{ platform_jumpstarter_namespace }}"
spec:
  authentication:
    autoProvisioning:
      enabled: false
    internal:
      enabled: true
      prefix: 'internal:'
      tokenLifetime: 43800h
    k8s:
      enabled: true
  certManager:
    enabled: true
    server:
      issuerRef:
        name: "letsencrypt-prod"
        group: cert-manager.io
        kind: ClusterIssuer
      selfSigned:
        caDuration: 87600h
        certDuration: 8760h
        enabled: true
        renewBefore: 360h
  controller:
    exporterOptions:
      offlineTimeout: 180s
    grpc:
      keepalive:
        intervalTime: 10s
        minTime: 1s
        permitWithoutStream: true
        timeout: 180s
    image: '{{ jumpstarter_image }}'
    imagePullPolicy: IfNotPresent
    replicas: 2
  routers:
    grpc:
      keepalive:
        intervalTime: 10s
        minTime: 1s
        permitWithoutStream: true
        timeout: 180s
    image: '{{ jumpstarter_image }}'
    imagePullPolicy: IfNotPresent
    replicas: 3
  baseDomain: "{{ platform_jumpstarter_namespace }}.apps.{{ cluster_base_domain }}"
