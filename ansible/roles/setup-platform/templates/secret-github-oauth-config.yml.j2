kind: Secret
apiVersion: v1
metadata:
  name: github-oauth-config
  namespace: {{ platform_devspaces_namespace }}
  labels:
    app.kubernetes.io/part-of: che.eclipse.org
    app.kubernetes.io/component: oauth-scm-configuration
  annotations:
    che.eclipse.org/oauth-scm-server: github
    che.eclipse.org/scm-server-endpoint: "https://{{ github_endpoint }}"
    che.eclipse.org/scm-github-disable-subdomain-isolation: 'false' 
type: Opaque
stringData:
  id: {{ github_devspaces_client_id }}
  secret: {{ github_devspaces_client_secret }}